<article xml:lang="de"
         article-type="research-article">
   <front>
      <article-meta>
         <title-group>
            <article-title>Tabellen-Test</article-title>
         </title-group>
      </article-meta>
   </front>
   <body>
      <sec>
         <label>1</label>
         <title>Tabellen</title>
         <p>Labeled Table:</p>
         <table-wrap position="float">
            <label>
				Tabelle
			1</label>
            <caption>
               <p>Caption T1</p>
            </caption>
            <table>
               <tbody>
                  <tr>
                     <td>a</td>
                     <td>b</td>
                  </tr>
               </tbody>
            </table>
         </table-wrap>
         <p>Floating Table:</p>
         <table-wrap position="float"
                     id="t2">
            <caption>
               <p>Caption T2</p>
            </caption>
            <table>
               <tbody>
                  <tr>
                     <td>c</td>
                     <td>d</td>
                  </tr>
               </tbody>
            </table>
         </table-wrap>
         <p>Noch eine labeled Table fuer Nummerierung.</p>
         <table-wrap position="float">
            <label>
				Tabelle
			2</label>
            <table>
               <tbody>
                  <tr>
                     <td>e</td>
                  </tr>
               </tbody>
            </table>
         </table-wrap>
      </sec>
   </body>
</article>