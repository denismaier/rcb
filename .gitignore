.build/
output/
.claude/settings.local.json
experiments/xproc-cleanup/out/
experiments/xproc-cleanup/jats-dtd/

# Built gem artifacts (gem build rcb.gemspec output); source is tracked, the
# packaged .gem is a build product.
*.gem

# Machine-specific tool-path overrides (copy from rcb.config.local.example.rb).
# Matched at any cascade level.
rcb.config.local.rb

# Real production content lives under pub/bop/<journal>/volume_<year>/ and
# stays local (real manuscripts, not committed). Journal-level config
# (metadata.yaml, rcb.rake, _assets/schematron) sits one level up and IS
# tracked. Demo content lives under pub/demoverlag/ (fully tracked) and is
# not matched here. One line per real publisher; a second publisher = a
# second line.
pub/bop/*/volume_*/
